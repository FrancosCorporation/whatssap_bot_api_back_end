# Copie para .env e substitua JWT_SECRET por um valor aleatório próprio.
NODE_ENV=development
HOST=127.0.0.1
PORT=3005

MONGO_URI=mongodb://127.0.0.1:27018
MONGO_URI_CONTAINER=mongodb://mongo:27017
NOME_DB=whatsapp_bot

# O exemplo é rejeitado pela aplicação até ser substituído por um segredo próprio.
JWT_SECRET=replace-with-a-random-value-of-at-least-32-bytes
JWT_EXPIRES_IN=2h
SALT_ROUNDS=12

# Origens completas e sem barra final, separadas por vírgula.
CORS_ORIGINS=http://localhost:3000
MAX_WHATSAPP_SESSIONS=3

# Opcional fora do Docker se o Chromium estiver em um caminho diferente.
PUPPETEER_EXECUTABLE_PATH=
